            "type": "integer"
          },
          "failure_count": {
            "minimum": 0.0,
            "title": "Failure Count",
            "type": "integer"
          },
          "finding_count": {
            "minimum": 0.0,
            "title": "Finding Count",
            "type": "integer"
          },
          "formal_verification_endpoint": {
            "default": "/v1/verify",
            "title": "Formal Verification Endpoint",
            "type": "string"
