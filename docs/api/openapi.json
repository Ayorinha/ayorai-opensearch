          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Judge2AtomRequest": {
        "additionalProperties": false,
        "description": "Strict public schema for a Judge 2 atom and its source-text span.",
        "properties": {
          "end_offset": {
            "exclusiveMinimum": 0.0,
            "description": "Exclusive end offset in source text; must be within the RFC 8785 safe-integer range.",
            "maximum": 9007199254740991.0,
            "title": "End Offset",
            "type": "integer"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "start_offset": {
            "description": "Inclusive start offset in the source text.",
            "minimum": 0.0,
            "title": "Start Offset",
            "type": "integer"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "start_offset",
          "end_offset"
        ],
        "title": "Judge2AtomRequest",
        "type": "object"
      },
