            "title": "Normalized Content Hash"
          },
          "origin_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Id"
          },
          "provenance_complete": {
            "default": true,
            "title": "Provenance Complete",
            "type": "boolean"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "source_id": {
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_location": {
            "minLength": 1,
            "title": "Source Location",
            "type": "string"
          },
          "start_offset": {
