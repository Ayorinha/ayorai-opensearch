            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "stance": {
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "NEUTRAL",
              "supports",
              "contradicts",
              "neutral"
            ],
            "title": "Stance",
            "type": "string"
          }
        },
        "required": [
          "id",
          "atom_id",
          "evidence_id",
          "stance"
        ],
        "title": "Judge2StanceRequest",
        "type": "object"
      },
      "Judge2VerificationRequest": {
        "additionalProperties": false,
        "description": "Strict JSON contract for the r2-a Judge 2.0.0 API path.",
        "properties": {
          "atoms": {
            "items": {
              "$ref": "#/components/schemas/Judge2AtomRequest"
            },
            "title": "Atoms",
            "type": "array"
          },
          "claim_id": {
            "minLength": 1,
            "title": "Claim Id",
            "type": "string"
          },
          "claim_text": {
            "minLength": 1,
            "title": "Claim Text",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Judge2EvidenceRequest"
            },
            "title": "Evidence",
            "type": "array"
          },
          "evidence_pool_integrity_ok": {
            "default": true,
            "title": "Evidence Pool Integrity Ok",
            "type": "boolean"
          },
          "factual_claim": {
            "default": true,
            "title": "Factual Claim",
            "type": "boolean"
          },
          "out_of_scope": {
            "default": false,
            "title": "Out Of Scope",
            "type": "boolean"
          },
          "protocol_version": {
            "const": "r2-a",
            "default": "r2-a",
            "title": "Protocol Version",
            "type": "string"
          },
          "retrieval_succeeded": {
            "default": true,
            "title": "Retrieval Succeeded",
            "type": "boolean"
          },
          "schema_version": {
            "const": "r2-a",
            "title": "Schema Version",
            "type": "string"
          },
          "source_texts": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Source Texts",
            "type": "object"
          },
          "stances": {
            "items": {
              "$ref": "#/components/schemas/Judge2StanceRequest"
            },
            "title": "Stances",
            "type": "array"
          },
          "temporal_anchor_present": {
            "default": true,
            "title": "Temporal Anchor Present",
            "type": "boolean"
          }
        },
        "required": [
          "schema_version",
          "claim_id",
          "claim_text",
          "atoms",
          "source_texts"
        ],
        "title": "Judge2VerificationRequest",
        "type": "object"
      },
      "Judge2VerificationResponse": {
        "additionalProperties": false,
        "description": "Public r2-a envelope containing the canonical Judge 2 result.",
        "properties": {
          "response_policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResponsePolicy"
              },
              {
                "type": "null"
              }
