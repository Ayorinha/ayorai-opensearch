        "enum": [
          "verified",
          "supported",
          "partially_supported",
          "unverified",
          "refuted",
          "conflicting"
        ],
        "title": "Verdict",
        "type": "string"
      },
      "VerificationAPIResponse": {
        "additionalProperties": false,
        "properties": {
          "judgments": {
            "items": {
              "$ref": "#/components/schemas/ClaimJudgmentResponse"
            },
            "title": "Judgments",
            "type": "array"
          },
          "schema_version": {
            "const": "r1-a",
            "default": "r1-a",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "$ref": "#/components/schemas/ResponsePolicy"
              }
            ],
            "title": "Status"
          },
          "traceability": {
            "$ref": "#/components/schemas/Traceability"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "judgments",
          "traceability"
        ],
        "title": "VerificationAPIResponse",
        "type": "object"
      },
      "VerificationRequest": {
        "additionalProperties": false,
        "not": {
          "properties": {
            "evidence": {
              "maxItems": 0
            },
            "stances": {
              "minItems": 1
            }
          },
          "required": [
            "stances"
          ],
          "type": "object"
        },
        "properties": {
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "minItems": 1,
            "title": "Claims",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence-Input"
            },
            "title": "Evidence",
            "type": "array"
          },
          "schema_version": {
            "const": "r1-a",
            "default": "r1-a",
            "title": "Schema Version",
            "type": "string"
          },
          "stances": {
            "items": {
              "$ref": "#/components/schemas/StanceEdge"
            },
            "title": "Stances",
            "type": "array"
          }
        },
        "required": [
          "claims"
        ],
        "title": "VerificationRequest",
        "type": "object"
      }
    }
  },
