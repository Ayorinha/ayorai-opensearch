        "type": "object"
      },
      "Evidence-Input": {
        "additionalProperties": false,
        "properties": {
          "canonical_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
