          "schema_version": {
            "const": "r2-a",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "result"
        ],
        "title": "Judge2VerificationResponse",
        "type": "object"
      },
      "QualityMode": {
        "enum": [
          "fast",
          "balanced",
          "deep"
        ],
        "title": "QualityMode",
        "type": "string"
      },
      "ResponsePolicy": {
        "description": "Transport-level abstention policy; never a factual verdict.",
        "enum": [
          "abstain/no_answer",
          "abstain/out_of_scope",
          "abstain/processing_error"
        ],
        "title": "ResponsePolicy",
        "type": "string"
      },
      "SearchRequest": {
        "properties": {
          "max_agents": {
            "default": 5,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Agents",
            "type": "integer"
          },
          "mode": {
            "$ref": "#/components/schemas/QualityMode",
