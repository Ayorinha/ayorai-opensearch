    "schemas": {
      "AuditFindingResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "title": "AuditFindingResponse",
        "type": "object"
      },
      "AuditResponse": {
        "properties": {
          "evidence_count": {
            "minimum": 0.0,
            "title": "Evidence Count",
            "type": "integer"
          },
          "failure_count": {
            "minimum": 0.0,
            "title": "Failure Count",
            "type": "integer"
          },
          "findings": {
