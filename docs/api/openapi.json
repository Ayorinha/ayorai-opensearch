          "claim",
          "source",
          "excerpt"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Failure": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "recoverable": {
            "default": true,
            "title": "Recoverable",
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/FailureType"
