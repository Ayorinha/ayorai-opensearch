              {
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              }
            ],
            "default": false,
            "title": "Require Primary Source"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
