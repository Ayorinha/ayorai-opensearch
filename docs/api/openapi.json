              "$ref": "#/components/schemas/AuditFindingResponse"
            },
            "title": "Findings",
            "type": "array"
          },
          "formal_verification_endpoint": {
            "default": "/v1/verify",
            "title": "Formal Verification Endpoint",
            "type": "string"
          },
          "independent_evidence_count": {
            "minimum": 0.0,
            "title": "Independent Evidence Count",
            "type": "integer"
          },
          "operation_status": {
            "default": "completed",
            "enum": [
              "completed",
              "failed",
              "not_recorded"
            ],
            "title": "Operation Status",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "verdict_authority": {
            "const": "not_adjudicated",
            "default": "not_adjudicated",
            "title": "Verdict Authority",
            "type": "string"
          },
          "verification": {
            "title": "Verification",
            "type": "null"
          },
          "verified_evidence_count": {
            "minimum": 0.0,
            "title": "Verified Evidence Count",
            "type": "integer"
          }
        },
        "required": [
          "trace_id",
          "evidence_count",
          "independent_evidence_count",
          "verified_evidence_count",
          "failure_count"
        ],
        "title": "AuditResponse",
        "type": "object"
      },
      "AuditTraceResponse": {
        "properties": {
          "evidence_count": {
            "minimum": 0.0,
