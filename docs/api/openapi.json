      "Judge2StanceRequest": {
        "additionalProperties": false,
        "description": "Strict public schema for an explicit atom/evidence stance edge.",
        "properties": {
          "atom_id": {
            "minLength": 1,
            "title": "Atom Id",
            "type": "string"
          },
          "evidence_id": {
            "minLength": 1,
            "title": "Evidence Id",
            "type": "string"
