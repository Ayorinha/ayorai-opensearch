          },
          "claim_id": {
            "minLength": 1,
            "title": "Claim Id",
            "type": "string"
          },
          "end_offset": {
            "description": "Must be greater than start_offset; the relational invariant is enforced by the API and Judge 2.",
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "End Offset",
            "type": "integer"
          },
          "excerpt": {
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
