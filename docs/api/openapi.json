            "title": "Cited Origin Id"
          },
          "claim_id": {
            "minLength": 1,
            "title": "Claim Id",
            "type": "string"
          },
          "end_offset": {
            "description": "Exclusive end offset; must be greater than start_offset.",
            "minimum": 0.0,
            "title": "End Offset",
            "type": "integer"
          },
          "excerpt": {
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "normalized_content_hash": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Content Hash"
          },
          "origin_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin Id"
          },
          "provenance_complete": {
            "default": true,
            "title": "Provenance Complete",
            "type": "boolean"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "source_id": {
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_location": {
            "minLength": 1,
            "title": "Source Location",
            "type": "string"
          },
          "start_offset": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Start Offset",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "claim_id",
          "source_id",
          "source_location",
          "retrieved_at",
          "start_offset",
          "end_offset",
          "excerpt"
