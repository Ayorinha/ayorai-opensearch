{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ayorinha/ayorai-opensearch/blob/main/docs/schemas/golden-evaluation-report-v1.schema.json",
  "title": "AYORAI ATTRACTOR Golden evaluation report v1",
  "description": "Versioned structural contract for reports emitted by evaluation.golden.evaluate_golden_v0. This schema validates report shape, not benchmark validity or performance claims.",
  "type": "object",
  "required": [
    "suite",
    "system",
    "network",
    "case_count",
    "corpus_document_count",
    "cases_with_global_verdict",
    "majority_class_baseline",
    "global_accuracy",
    "balanced_accuracy",
    "bootstrap_95_ci",
    "confusion_matrix",
    "legacy_accuracy",
    "mcnemar_vs_legacy",
    "abstention_contracts",
    "accuracy_by_category",
    "accuracy_by_state",
    "latency_ms",
    "results",
    "git_sha",
    "content_sha256",
    "semantic_digest_version",
    "semantic_sha256"
  ],
  "properties": {
    "suite": { "type": "string", "minLength": 1 },
    "system": { "type": "string", "minLength": 1 },
    "network": { "type": "boolean" },
    "case_count": { "type": "integer", "minimum": 0 },
    "corpus_document_count": { "type": "integer", "minimum": 0 },
    "cases_with_global_verdict": { "type": "integer", "minimum": 0 },
    "majority_class_baseline": { "$ref": "#/$defs/accuracy" },
    "global_accuracy": { "$ref": "#/$defs/accuracy" },
    "balanced_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
    "bootstrap_95_ci": {
      "type": "object",
      "required": ["lower", "upper", "iterations", "seed"],
      "properties": {
        "lower": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper": { "type": "number", "minimum": 0, "maximum": 1 },
        "iterations": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "confusion_matrix": { "type": "object" },
    "legacy_accuracy": { "$ref": "#/$defs/accuracy" },
    "mcnemar_vs_legacy": {
      "type": "object",
      "required": ["legacy_correct_new_wrong", "new_correct_legacy_wrong", "exact_p"],
      "properties": {
        "legacy_correct_new_wrong": { "type": "integer", "minimum": 0 },
        "new_correct_legacy_wrong": { "type": "integer", "minimum": 0 },
        "exact_p": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "abstention_contracts": {
      "type": "object",
      "required": ["case_count", "correct", "evaluated", "expected_statuses"],
      "properties": {
        "case_count": { "type": "integer", "minimum": 0 },
        "correct": { "type": "integer", "minimum": 0 },
        "evaluated": { "type": "boolean" },
        "expected_statuses": { "type": "object" }
      },
      "additionalProperties": true
    },
    "accuracy_by_category": { "type": "object", "additionalProperties": { "$ref": "#/$defs/accuracy" } },
    "accuracy_by_state": { "type": "object", "additionalProperties": { "$ref": "#/$defs/accuracy" } },
    "latency_ms": {
      "type": "object",
      "required": ["p50", "p95"],
      "properties": {
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "results": { "type": "array", "items": { "type": "object" } },
    "git_sha": { "type": "string", "minLength": 1 },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semantic_digest_version": { "type": "string", "minLength": 1 },
    "semantic_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "accuracy": {
      "type": "object",
      "required": ["correct", "total", "accuracy"],
      "properties": {
        "correct": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
