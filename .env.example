ATTRACTOR_PROVIDER=mock
ATTRACTOR_LOG_LEVEL=INFO
ATTRACTOR_AUTH_MODE=api_key
ATTRACTOR_API_KEY_PEPPER=
ATTRACTOR_API_KEYS_HMAC_SHA256=
ATTRACTOR_SEARCH_ENDPOINT=
ATTRACTOR_SEARCH_API_KEY=
ATTRACTOR_OPENSEARCH_ENDPOINT=
ATTRACTOR_OPENSEARCH_INDEX=
ATTRACTOR_OPENSEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
ATTRACTOR_AUDIT_HMAC_KEYS=
ATTRACTOR_AUDIT_HMAC_REQUIRED=false
ATTRACTOR_AUDIT_RETENTION_DAYS=
# Verification-event log of /v1/verify r2-a (ADR-010): off | local | required.
# With local or required, KEY (Ed25519 seed, 64 hex, from a secret manager) and ORIGIN are mandatory.
ATTRACTOR_VERIFY_LOG_MODE=off
ATTRACTOR_VERIFY_LOG_KEY=
ATTRACTOR_VERIFY_LOG_ORIGIN=
ATTRACTOR_VERIFY_LOG_DB=.attractor/verify-log.sqlite3
